# Core service configuration
NODE_ENV=development
PORT=8080

# Binance credentials (leave blank when using offline mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_OFFLINE_MODE=true
BINANCE_HTTP_TIMEOUT_MS=12000
BINANCE_HTTP_MAX_RETRIES=3
BINANCE_HTTP_RETRY_DELAY_MS=400

SYMBOL_DISCOVERY_ENABLED=true
SYMBOL_DISCOVERY_REFRESH_SECONDS=180
SYMBOL_DISCOVERY_TOP_LIMIT=200
SYMBOL_DISCOVERY_MAX_ACTIVE=200
SYMBOL_DISCOVERY_MIN_QUOTE_VOLUME=2000000
SYMBOL_DISCOVERY_QUOTE_ASSETS=USDT
SYMBOL_DISCOVERY_ROUTE_LIMIT=10

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_OFFLINE_MODE=true
OPENAI_PRIMARY_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODEL=gpt-5-nano
OPENAI_MAX_OUTPUT_TOKENS=64
OPENAI_MAX_REQUESTS_PER_MINUTE=12
OPENAI_DECISION_CACHE_TTL_MS=180000
OPENAI_DECISION_MIN_INTERVAL_MS=45000
OPENAI_FINGERPRINT_DECIMALS=3
OPENAI_FINGERPRINT_ARRAY_SAMPLE=24
OPENAI_HTTP_TIMEOUT_MS=20000
OPENAI_HTTP_MAX_RETRIES=3
OPENAI_HTTP_RETRY_DELAY_MS=750

# Trading controls
INITIAL_BALANCE=100000
LOOP_INTERVAL_SECONDS=30
MAX_POSITION_LEVERAGE=5
